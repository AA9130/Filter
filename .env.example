# ---------------------------------------------------------------------------
# Contact details — REPLACE THE PLACEHOLDERS BELOW, then rename to .env.local
# ---------------------------------------------------------------------------

# Phone number in full international format, digits only (used for tel: links)
NEXT_PUBLIC_PHONE_NUMBER=971500000000

# Human-friendly version shown in the header / CTAs
NEXT_PUBLIC_PHONE_DISPLAY=+971 50 000 0000

# WhatsApp number in full international format, digits only, no + or spaces
NEXT_PUBLIC_WHATSAPP_NUMBER=971500000000

# Public inbox for the contact section
NEXT_PUBLIC_EMAIL=info@aquapureuae.ae

# Canonical site URL (used for metadata, Open Graph, sitemap.xml)
NEXT_PUBLIC_SITE_URL=https://www.aquapureuae.ae

# Where contact-form leads get delivered. Any URL that accepts a JSON POST:
# a Slack/Discord incoming webhook, Zapier/Make/n8n, or a Google Apps Script
# bound to a Sheet. Server-side only — do NOT prefix with NEXT_PUBLIC_.
# Leave unset and leads are only written to the server log.
LEAD_WEBHOOK_URL=

# Durable sink, tried BEFORE notification. An Apps Script bound to a Google
# Sheet is the cheapest option that is also a UI the owner can read.
LEAD_STORE_URL=

# Optional local JSONL append. Only durable on a host with a writable disk
# (a VPS or container), NOT on serverless platforms.
LEAD_LOG_FILE=

# Shared secret echoed to sinks, so a publicly-reachable relay (an Apps Script
# web app must accept "Anyone") can reject requests that are not from this site.
LEAD_SHARED_SECRET=
