{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "overrides": [
    {
      "files": ["components/**/*.ts", "components/**/*.tsx"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/content", "@/content/*", "**/content/*.json"],
                "message": "Content boundary: components must not read content. Pages read it via lib/content and pass it down as props. Import only types from '@/lib/content'."
              }
            ]
          }
        ]
      }
    }
  ]
}
