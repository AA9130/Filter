{
  "name": "aquapure-uae",
  "version": "1.0.0",
  "private": true,
  "description": "Conversion-optimized website for a UAE water filter installation, maintenance & AMC services business.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "node --import \"file://$PWD/tests/register.ts\" --test tests/*.test.ts",
    "audit:seo": "node --import \"file://$PWD/tests/register.ts\" scripts/seo-audit.ts",
    "content": "node --import \"file://$PWD/tests/register.ts\" scripts/content.ts",
    "visibility": "node --import \"file://$PWD/tests/register.ts\" scripts/visibility.ts",
    "knowledge:sync": "node --import \"file://$PWD/tests/register.ts\" scripts/knowledge-sync.ts",
    "verify": "npm run typecheck && npm run lint && npm run build && npm run test && npm run audit:seo"
  },
  "dependencies": {
    "lucide-react": "^0.544.0",
    "next": "^15.5.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.34.0",
    "eslint-config-next": "^15.5.2",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2"
  }
}
